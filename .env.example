# ==============================================================================
# DemandAI - Environment Variables & API Keys Template (.env.example)
# Copy this file to .env and fill in your keys: cp .env.example .env
# ==============================================================================

# --- Supabase Database Configuration ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# --- AI Model Providers & LLM Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Supply Chain & ERP Integrations ---
SAP_API_KEY=your_sap_key_here
ORACLE_ERP_API_KEY=your_oracle_erp_key_here
SNOWFLAKE_ACCOUNT=your_snowflake_account_here
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_DATABASE=DEMAND_FORECASTING
SNOWFLAKE_SCHEMA=PUBLIC

# --- Backend Server Configuration ---
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=replace_with_secure_random_key

# --- Frontend Vite Variables ---
VITE_API_BASE_URL=/api
VITE_APP_NAME="DemandAI - Demand Forecasting System"
VITE_ENABLE_MOCK_FALLBACK=true
